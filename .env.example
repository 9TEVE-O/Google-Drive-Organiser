# ============================================================================
# Drive Organizer — Environment Variable Configuration Template (.env.example)
# Copy this file to `.env` for local development: `cp .env.example .env`
# NEVER commit real secrets or API keys to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI Orchestration Service (Server-Side Only — NEVER prefix with VITE_)
# ----------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key from Google AI Studio.
# Format: String starting with "AIza..." (e.g., AIzaSyYourApiKeyHere)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ----------------------------------------------------------------------------
# 2. Server Runtime & Network Binding (Optional — Defaulted Automatically)
# ----------------------------------------------------------------------------
# APP_URL: Canonical public URL where this application is hosted (auto-injected in AI Studio).
# Format: Full HTTP/HTTPS origin URL without trailing slash
APP_URL="MY_APP_URL"

# NODE_ENV: Execution mode ("development" | "production" | "test", defaults to "development")
# NODE_ENV="development"

# PORT: TCP port on which the Express + Vite server listens (defaults to 3000)
# Format: Integer (1024-65535)
# PORT="3000"

# ----------------------------------------------------------------------------
# 3. Firebase Identity & Server-Side Token Verification (Optional Overrides)
# ----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID: Defaults automatically to projectId in firebase-applet-config.json
# Format: Lowercase alphanumeric string with hyphens
# FIREBASE_PROJECT_ID="gen-lang-client-0910713313"

# GOOGLE_APPLICATION_CREDENTIALS: (Optional in Cloud Run; used locally if not using gcloud ADC)
# Path to a Firebase Admin service account JSON key file used by `applicationDefault()`.
# Format: Absolute or relative filesystem path (e.g., ./service-account.json)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# ----------------------------------------------------------------------------
# 4. Client-Side Build Overrides (Optional — Safe for Browser Exposure)
# ----------------------------------------------------------------------------
# VITE_API_BASE_URL: Optional origin URL if the AI backend is hosted on a separate domain.
# Defaults to "" (same-origin Express server).
# VITE_API_BASE_URL=""
