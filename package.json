{
  "name": "drive-organizer",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered Google Drive Workspace Organizer, Task Scheduler, and Executive Reporting Platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/__tests__/production.test.ts",
    "clean": "rm -rf dist server.js",
    "mcp": "tsx mcp-server.ts"
  },
  "dependencies": {
    "@google/genai": "2.6.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "firebase": "12.13.0",
    "firebase-admin": "14.5.0",
    "framer-motion": "13.4.4",
    "lucide-react": "0.546.0",
    "motion": "12.40.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.19.19",
    "autoprefixer": "10.5.0",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "5.8.3",
    "vite": "6.4.2"
  }
}
